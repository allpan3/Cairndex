# Cairndex server configuration — OPTIONAL. Copy to `.env` beside
# docker-compose.yml if you run from a shell and would rather keep settings out
# of the compose file. Every value here already has a working default written
# into docker-compose.yml, so a NAS Docker UI that pastes the compose file needs
# none of this; edit the marked lines in that file instead.
#
# The repository root has a larger .env.example that also configures the
# containerized *development* stack. You do not need it here.

# --- The one you must get right -----------------------------------------------

# Absolute host path to the library root Cairndex should manage, mounted into
# the container at /libraries/main.
#
# It must be writable by uid 10001 (the container's non-root user), because
# Cairndex keeps each library's portable package at <root>/.cairndex/. On Linux
# that uid is literal on the host too, so files Cairndex creates there are owned
# by 10001:10001 — worth knowing when you set up backups.
#
#   sudo chown -R 10001:10001 /path/to/library/.cairndex   # if it already exists
#   sudo setfacl -m u:10001:rwx /path/to/library           # or grant on the root
CAIRNDEX_LIBRARY_PATH=/mnt/media

# --- Networking ---------------------------------------------------------------

# Address the container port is published on. 0.0.0.0 means every interface on
# the NAS, which is what makes the app reachable from your other machines — the
# reason to run it on a NAS at all. Narrow it to a single interface by naming
# that address instead.
#
# There is no authentication yet (AGENTS.md §12), so whatever can reach this
# port can use the app. Keep it to your own network: no port-forwarding, no
# public interface. Tailscale or a VPN is the way in from outside.
CAIRNDEX_BIND_ADDR=0.0.0.0
CAIRNDEX_PORT=8000

# --- Identity (ADR-0018) ------------------------------------------------------

# Written into each library's ownership lease. Without it the lease records the
# container's hostname — a hex id — and another machine that finds this server
# holding a library can only report that.
CAIRNDEX_MACHINE_NAME=nas

# The URL clients can reach this server at. When set to a NON-loopback address,
# a machine that finds this server holding a library can offer "connect there
# instead" rather than only naming a host. A loopback URL means nothing to a
# different machine and is never offered, so leave it unset for a local trial.
# CAIRNDEX_ADVERTISED_URL=http://nas.local:8000

# --- Image --------------------------------------------------------------------

# Which published tag to run. Pinning a version means `docker compose pull`
# cannot change what runs under you; `latest` is the convenient default.
# CAIRNDEX_IMAGE_TAG=0.1.0

# --- Write mode (ADR-0013) ----------------------------------------------------

# Deployment master switch for guarded file operations. `allowed` lets each
# library's own opt-in (off by default) decide; `disabled` forces every library
# read-only and makes the per-library toggle un-flippable, which is what a
# shared or hardened deployment wants.
# CAIRNDEX_WRITE_MODE=allowed

# --- Everything else ----------------------------------------------------------

# The image has working defaults for transcode limits, ffmpeg hwaccel, lease
# timing, trash retention, and storyboards. docs/deployment.md has the full
# table. Any CAIRNDEX_-prefixed variable set here reaches the server.
# CAIRNDEX_TRANSCODE_MAX_SESSIONS=2
# The production Compose default is true: compatible videos use copy-only HLS
# instead of remote progressive Range requests. Set false to restore direct.
# CAIRNDEX_PREFER_HLS=true
# CAIRNDEX_FFMPEG_HWACCEL=vaapi
# CAIRNDEX_TRASH_RETENTION_DAYS=0
