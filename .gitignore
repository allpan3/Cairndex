# --- Secrets and local config ---
.env
.env.*
!.env.example
*.local

# --- Python (apps/server) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / frontend (apps/web) ---
node_modules/
apps/web/dist/
apps/web/build/
.vite/
playwright-report/
test-results/
blob-report/

# --- Eagle UI reference screenshots: kept locally for reference, never committed ---
# The folder is tracked via its README only; any images dropped in stay local.
docs/reference/eagle/*
!docs/reference/eagle/README.md

# --- Application data: never commit media, databases, caches, thumbnails ---
data/
storage/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
var/cache/
var/thumbnails/
var/media/

# Note: we deliberately do NOT blanket-ignore media extensions at the repo
# root. `*.ts` would shadow TypeScript source, and globs like `*.mp4` would
# shadow the small synthetic media fixtures generated for tests (AGENTS.md
# §15). Real source media never lives in the repo — it stays under mounted
# storage roots and the app-data/cache directories ignored above. Anything
# that must be excluded belongs in one of those directories, not matched by
# extension. Review diffs before committing regardless (AGENTS.md §12).

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Logs ---
*.log
logs/
