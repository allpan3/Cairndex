{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairndex",
  "version": "0.1.0",
  "identifier": "dev.cairndex.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../web run build && node ../check-sidecar-staged.mjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cairndex",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "dragDropEnabled": true,
        "backgroundColor": "#141519"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cairndex"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../../server/packaging/dist/cairndex-sidecar": "cairndex-sidecar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
