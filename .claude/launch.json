{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "autoPort": true,
      "cwd": "apps/web"
    },
    {
      "name": "server",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "cairndex.main:app", "--reload", "--port", "8000"],
      "port": 8000,
      "cwd": "apps/server"
    }
  ]
}
