# Cairndex Docker configuration. Copy to .env and edit; .env is git-ignored, so
# never commit real paths or secrets.
#
# One file serves both stacks. The dev stack (docker-compose.yml) reads the
# CAIRNDEX_DEV_* keys; the production stack (docker-compose.prod.yml) reads the
# rest. Keys neither stack needs are simply ignored.

# =============================================================================
# Development stack — `docker compose up --build`
# =============================================================================

# Host path of the library the dev container serves, mounted at /storage/media.
# Point this at a scratch library, NOT one your desktop app or the native
# `just dev` server is also serving: a library may be open on exactly one server
# at a time (ADR-0018), and the second one to try is refused.
#   just docker-dev-library     # seeds a small one at var/docker-library
CAIRNDEX_DEV_LIBRARY_PATH=./var/docker-library

# Host ports for the dev stack. Change these to run it alongside a native
# `just dev` (which already holds 8000 and 5173) rather than instead of it.
CAIRNDEX_DEV_API_PORT=8000
CAIRNDEX_DEV_WEB_PORT=5173

# How the dev container names itself in a library's ownership lease. Separate
# from the production stack's CAIRNDEX_MACHINE_NAME below so that one .env can
# configure both without the dev container claiming to be your NAS.
# CAIRNDEX_DEV_MACHINE_NAME=cairndex-dev-container

# =============================================================================
# Production stack — `docker compose -f docker-compose.prod.yml up --build -d`
# =============================================================================

# --- Host networking ----------------------------------------------------------
# Address the container port is published on. Default 127.0.0.1 keeps the app
# off the network until you front it with a reverse proxy or Tailscale.
# Set to 0.0.0.0 only on a trusted private network (AGENTS.md §12).
CAIRNDEX_BIND_ADDR=127.0.0.1
CAIRNDEX_PORT=8000

# --- Cairndex library --------------------------------------------------------
# Absolute host path to the library root you want Cairndex to manage. Mounted
# into the container at /storage/media. The mount must be writable because the
# current per-library model stores portable metadata and cache under
# /storage/media/.cairndex/{manifest.json,library.db,cache/}.
# Cairndex's app logic remains metadata-only for source media: it does not move,
# rename, delete, or rewrite your media files outside an explicit write-mode
# operation (ADR-0013). A writable mount is not write mode.
MEDIA_HOST_PATH=/mnt/media

# --- Identifying this server (ADR-0018) --------------------------------------
# Written into each library's ownership lease. Without it the lease records the
# container's hostname — a hex id — and another machine that finds this server
# holding a library can only report that.
CAIRNDEX_MACHINE_NAME=nas

# The URL clients can reach this server at. When set to a NON-loopback address,
# another machine that finds this server holding a library can offer "connect
# there instead" rather than only naming a host. Leave unset for a local trial;
# a loopback URL means nothing to a different machine and is never offered.
# CAIRNDEX_ADVERTISED_URL=http://nas.local:8000

# --- Write mode (ADR-0013) ---------------------------------------------------
# Deployment master switch for guarded file operations. `allowed` lets each
# library's own opt-in (off by default) decide; `disabled` forces every library
# read-only and makes the per-library toggle un-flippable, which is what a
# shared or hardened deployment wants.
# CAIRNDEX_WRITE_MODE=allowed

# --- Other app configuration (read by the backend; CAIRNDEX_-prefixed) -------
# These have working defaults baked into the image; see docs/deployment.md for
# the full table (transcode limits, ffmpeg hwaccel, lease timing, trash
# retention, storyboards).
# CAIRNDEX_TRANSCODE_MAX_SESSIONS=2
# CAIRNDEX_FFMPEG_HWACCEL=vaapi
# CAIRNDEX_TRASH_RETENTION_DAYS=0

# --- Optional per-library passphrase lock (ADR-0010) --------------------------
# Each library can independently require an owner passphrase. It is off by
# default and needs no environment variable: set it per library with
#   uv run python -m cairndex.devtools.set_passphrase --library-root /path/to/lib
# Only a hash is stored (in the library's manifest); unlock is a server-side
# session (opaque HTTP-only cookie), scoped to that one library. This is a
# private LAN/Tailscale guardrail, NOT public-internet hardening.
