# Cairndex production configuration (docker-compose.prod.yml).
# Copy to .env and edit. .env is git-ignored; never commit real paths/secrets.

# --- Host networking ----------------------------------------------------------
# Address the container port is published on. Default 127.0.0.1 keeps the app
# off the network until you front it with a reverse proxy or Tailscale.
# Set to 0.0.0.0 only on a trusted private network (AGENTS.md §12).
CAIRNDEX_BIND_ADDR=127.0.0.1
CAIRNDEX_PORT=8000

# --- Cairndex library --------------------------------------------------------
# Absolute host path to the library root you want Cairndex to manage. Mounted
# into the container at /storage/media. The mount must be writable because the
# current per-library model stores portable metadata and cache under
# /storage/media/.cairndex/{manifest.json,library.db,cache/}.
# Cairndex's app logic remains metadata-only for source media: it does not move,
# rename, delete, or rewrite your media files in the normal MVP path.
MEDIA_HOST_PATH=/mnt/media

# --- App configuration (read by the backend; CAIRNDEX_-prefixed) -------------
# These have working defaults baked into the image; uncomment to override.
# CAIRNDEX_ENVIRONMENT=production
# CAIRNDEX_STATIC_DIR=/app/web
# CAIRNDEX_DATA_DIR=/data

# --- Optional per-library passphrase lock (ADR-0010) --------------------------
# Each library can independently require an owner passphrase. It is off by
# default and needs no environment variable: set it per library with
#   uv run python -m cairndex.devtools.set_passphrase --library-root /path/to/lib
# Only a hash is stored (in the library's manifest); unlock is a server-side
# session (opaque HTTP-only cookie), scoped to that one library. This is a
# private LAN/Tailscale guardrail, NOT public-internet hardening.
